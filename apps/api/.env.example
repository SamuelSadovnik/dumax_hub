# Banco (bate com o docker-compose.yml)
DATABASE_URL="postgresql://dumax:dumax@localhost:5433/dumax_hub?schema=public"

# Troque em produção! (openssl rand -hex 32)
# Gerados por "npm run secrets" (não use valores de exemplo em produção)
JWT_SECRET="troque-este-segredo-por-um-bem-grande"
DATA_ENCRYPTION_KEY=
JWT_EXPIRES_IN="7d"

PORT=3333
NODE_ENV=development

# URL pública do front — usada nos links de vaga/teste enviados aos candidatos
WEB_URL="http://localhost:5173"

UPLOAD_DIR="./uploads"

# Pulse semanal: toda sexta às 09:00 (horário de Brasília)
PULSE_CRON="0 9 * * 5"
TZ="America/Sao_Paulo"

# E-mail (opcional). Sem SMTP_HOST, os e-mails só aparecem no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dumax Hub <nao-responda@dumax.com.br>"

# ───── Ponto eletrônico ─────
# "mock" gera batidas de demonstração; "http" busca da API do seu sistema de ponto
PONTO_PROVIDER="mock"
# GET {PONTO_API_URL}?from=ISO&to=ISO  → lista de batidas (veja docs/INTEGRACAO_PONTO.md)
PONTO_API_URL=
PONTO_API_TOKEN=
# Segredo do webhook (header X-Ponto-Secret) — opcional
PONTO_WEBHOOK_SECRET=
PONTO_SYNC_CRON="*/15 * * * *"

# ───── Assistente de IA ─────
# Use Claude (pago, https://console.anthropic.com) OU Gemini (tem plano grátis, https://aistudio.google.com).
# AI_PROVIDER: anthropic ou gemini. Se ficar vazio, usa a chave que estiver preenchida.
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Opcional. Padrão: claude-sonnet-5-5 (Claude) ou gemini-2.5-flash (Gemini)
AI_MODEL=
